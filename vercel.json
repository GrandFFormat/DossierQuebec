{
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude,glob)**/*.md' ':(exclude,glob)**/scripts/**' ':(exclude,glob)**/scrapers/**' ':(exclude,glob)*/lib/**' ':(exclude,glob)**/test/**' ':(exclude,glob).github/**' ':(exclude,glob)*/package.json' ':(exclude,glob)*/package-lock.json' ':(exclude,glob)**/*.cmd'",
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/alertes-projets",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/feed.js": {
      "includeFiles": "api/feed-data.xml"
    }
  },
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ],
  "headers": [
    {
      "source": "/quebec/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/montreal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/levis/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/longueuil/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/quebec",
      "destination": "/quebec/",
      "permanent": true
    },
    {
      "source": "/villedequebec/(.*)",
      "destination": "/quebec/$1",
      "permanent": true
    },
    {
      "source": "/villedequebec",
      "destination": "/quebec/",
      "permanent": true
    },
    {
      "source": "/montreal",
      "destination": "/montreal/",
      "permanent": true
    },
    {
      "source": "/villedemontreal/(.*)",
      "destination": "/montreal/$1",
      "permanent": true
    },
    {
      "source": "/villedemontreal",
      "destination": "/montreal/",
      "permanent": true
    },
    {
      "source": "/levis",
      "destination": "/levis/",
      "permanent": true
    },
    {
      "source": "/longueuil",
      "destination": "/longueuil/",
      "permanent": true
    }
  ]
}
