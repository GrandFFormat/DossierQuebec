{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/villedequebec/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/villedequebec",
      "destination": "/villedequebec/",
      "permanent": true
    }
  ]
}
