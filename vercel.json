{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    }
  ],
  "functions": {
    "api/feed.js": {
      "includeFiles": "api/feed-data.xml"
    }
  },
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ],
  "headers": [
    {
      "source": "/villedequebec/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/villedequebec",
      "destination": "/villedequebec/",
      "permanent": true
    }
  ]
}
