+-- Produits d'abonnement DossierQuébec : ville | province | duo
+-- À coller dans Supabase → SQL Editor → Run.
+--
+-- Un compte choisit ville OU province OU duo (une seule ligne / user_id dans `abonnements`).
+-- Les abonnés Stripe legacy (anciens STRIPE_PRIX / STRIPE_PRIX_ANNUEL sans metadata produit)
+-- et les abonnements source=manuel actifs sont traités comme **duo** côté applicatif
+-- (api/_stripe.js : aAccesPlein, synchroniser).
+--
+-- Après exécution : créer 6 prix Stripe CAD (voir docs/abo-ville-province.md) et poser
+-- les variables Vercel STRIPE_PRIX_VILLE, _VILLE_ANNUEL, _PROVINCE, _PROVINCE_ANNUEL,
+-- _DUO, _DUO_ANNUEL. STRIPE_PRIX + STRIPE_PRIX_ANNUEL restent des alias/fallback duo.
+
+alter table public.abonnements
+  add column if not exists produit text;
+-- valeurs: ville | province | duo
+alter table public.abonnements drop constraint if exists abonnements_produit_check;
+alter table public.abonnements add constraint abonnements_produit_check
+  check (produit is null or produit in ('ville','province','duo'));
+
+comment on column public.abonnements.produit is
+  'ville | province | duo ; null = legacy (traité comme duo côté app)';
